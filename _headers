# Netlify / Cloudflare Pages headers. Keep the CSP in sync with the <meta> CSP in index.html.
# 'unsafe-eval' + embed-cdn.spotifycdn.com: required only by Spotify's official iFrame API bundle (eval'd webpack modules).
# frame-src lists only platforms whose embeds are used (see js/platforms.js -> frameSrc).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-wMN+mlF5/lbEMR70cf40Jgn4jopAI/p3LrhOu5tsqkY=' 'unsafe-eval' https://open.spotify.com https://embed-cdn.spotifycdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn2.suno.ai https://*.spotifycdn.com https://i.scdn.co; font-src 'self'; connect-src 'self'; media-src 'self' https:; frame-src https://open.spotify.com https://suno.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/sw.js
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=604800
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
